{
  "name": "@apibara/starknet-rpc",
  "version": "2.1.4",
  "repository": "apibara/typescript-sdk",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "unbuild",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "pnpm lint --write",
    "format": "biome format . --write",
    "test": "vitest",
    "test:ci": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^20.12.13",
    "@types/ws": "^8.18.1",
    "unbuild": "^2.0.0",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@apibara/protocol": "workspace:*",
    "ws": "^8.21.0"
  }
}
